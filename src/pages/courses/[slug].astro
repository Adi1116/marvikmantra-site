---
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import BatchTable from "../../components/BatchTable.astro";
import { courses } from "../../data/courses";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
---

<Layout title={course.name} description={course.title}>
  <section class="border-b border-ink/10 bg-parchment">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">{course.badge}</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">
        {course.title}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate">{course.description}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 border border-ink/15 bg-paper p-8 md:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-crimson">Course Name</p>
        <p class="mt-2 font-display text-lg font-bold text-ink">{course.name}</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-crimson">Target Students</p>
        <p class="mt-2 font-display text-lg font-bold text-ink">{course.targetStudents}</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-crimson">Focus</p>
        <p class="mt-2 text-sm leading-relaxed text-slate">{course.focus}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Batch Schedule & Starting Dates</p>
    <div class="mt-6">
      <BatchTable program={course.name} batches={course.batches} />
    </div>
  </section>

  <section class="border-y border-ink/10 bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Course Structure & Academic Details</p>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          Object.entries({
            "Admission Mode": course.structure.admissionMode,
            "Course Duration": course.structure.courseDuration,
            "Subjects Covered": course.structure.subjectsCovered,
            "Class Frequency": course.structure.classFrequency,
            "Next Progression": course.structure.nextProgression,
          }).map(([label, value]) => (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-slate">{label}</dt>
              <dd class="mt-1 text-sm leading-snug text-ink">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Course Benefits</p>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink">{course.name} Benefits</h2>
    <div class="mt-8 grid gap-x-8 gap-y-6 md:grid-cols-2">
      {
        course.benefits.map((b) => (
          <div class="border-t border-gold/40 pt-4">
            <h3 class="font-display text-base font-semibold text-ink">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate">{b.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-ink/10 bg-ink text-parchment">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-bright">Exam Planning & Test Schedule</p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-parchment/70">
        A systematic testing framework designed to build exam temperament and ensure consistent academic progress.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          course.examPlan.map((e) => (
            <div class="border border-parchment/15 p-6">
              <p class="font-display text-base font-bold">{e.name}</p>
              <p class="mt-1 font-mono text-xs text-gold-bright">{e.cadence}</p>
              <p class="mt-3 text-sm leading-relaxed text-parchment/70">{e.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="border border-ink/15 bg-paper p-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Learning Environment & Peer Impact</p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate">
        The impact of the best student pool at Marvik Mantra Jaipur — the pattern of results in previous years shows that a student's development is greatly influenced by their peer group. When a student studies among a talented pool, they're motivated to reach their peak potential, leading to optimal performance.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 font-mono text-xs uppercase tracking-wider text-gold">
        <span class="rounded-sm bg-gold/10 px-3 py-1.5">Peer Learning</span>
        <span class="rounded-sm bg-gold/10 px-3 py-1.5">Healthy Competition</span>
        <span class="rounded-sm bg-gold/10 px-3 py-1.5">Collective Excellence</span>
        <span class="rounded-sm bg-gold/10 px-3 py-1.5">Focused Growth</span>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
