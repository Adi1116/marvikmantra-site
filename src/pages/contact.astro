---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import WhyChoose from "../components/WhyChoose.astro";
import { site } from "../data/site";
import { courses } from "../data/courses";
---

<Layout title="Contact Us" description="Get in touch with MarvikMantra — have questions? We're here to help you choose the right path to success.">
  <PageHero
    eyebrow="Get in Touch"
    title="Contact Us"
    subtitle="Have questions? We're here to help you choose the right path to success."
  />

  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Send Us a Message</p>

      <!--
        TODO (dev note): this form has no backend yet. Astro's static build
        can't process submissions on its own — wire the `action` up to a
        form service (e.g. Formspree, Getform) or a small serverless
        function before launch, then remove this comment.
      -->
      <form class="mt-6 space-y-4">
        <div>
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-slate">Full Name *</label>
          <input id="name" name="name" type="text" required class="mt-1.5 w-full border border-ink/20 bg-paper px-4 py-2.5 text-sm text-ink focus:border-gold" />
        </div>
        <div>
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-slate">Email Address *</label>
          <input id="email" name="email" type="email" required class="mt-1.5 w-full border border-ink/20 bg-paper px-4 py-2.5 text-sm text-ink focus:border-gold" />
        </div>
        <div>
          <label for="phone" class="font-mono text-xs uppercase tracking-wider text-slate">Contact Number *</label>
          <input id="phone" name="phone" type="tel" required class="mt-1.5 w-full border border-ink/20 bg-paper px-4 py-2.5 text-sm text-ink focus:border-gold" />
        </div>
        <div>
          <label for="course" class="font-mono text-xs uppercase tracking-wider text-slate">Course Interested In *</label>
          <select id="course" name="course" required class="mt-1.5 w-full border border-ink/20 bg-paper px-4 py-2.5 text-sm text-ink focus:border-gold">
            <option value="">Select Course</option>
            {courses.map((c) => <option value={c.slug}>{c.title}</option>)}
          </select>
        </div>
        <div>
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-slate">Message</label>
          <textarea id="message" name="message" rows="4" class="mt-1.5 w-full border border-ink/20 bg-paper px-4 py-2.5 text-sm text-ink focus:border-gold"></textarea>
        </div>
        <button type="submit" class="w-full rounded-sm bg-crimson px-7 py-3.5 font-display text-sm font-semibold text-parchment transition-colors hover:bg-ink">
          Send Message
        </button>
      </form>
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">Our Locations</p>
      <p class="mt-2 text-sm text-slate">We operate through {site.locations.length} offices across Jaipur</p>

      <div class="mt-6 space-y-6">
        {
          site.locations.map((loc) => (
            <div class="border border-ink/15 bg-paper p-6">
              <h3 class="font-display text-lg font-bold text-ink">{loc.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate">
                <a href={loc.mapsUrl} class="hover:text-gold">{loc.address}</a>
              </p>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm text-ink">
                {site.phones.map((p) => (
                  <a href={`tel:${p.replace(/\s/g, "")}`} class="hover:text-gold">{p}</a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <WhyChoose />
</Layout>
