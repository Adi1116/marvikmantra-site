---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import WhyChoose from "../components/WhyChoose.astro";
import CTASection from "../components/CTASection.astro";
import { founders, foundingDirector, mission, vision } from "../data/site";
---

<Layout
  title="About Us"
  description="Learn about MarvikMantra, a trusted coaching institute for NEET, JEE and foundation courses. Meet our experienced faculty and discover our teaching approach."
>
  <PageHero
    eyebrow="About MarvikMantra"
    title="MarvikMantra Education Pvt. Ltd."
    subtitle="Quality coaching for IIT-JEE, NEET, Olympiad, and Board exams with expert faculty and result-oriented guidance."
  />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">About MarvikMantra Education</p>
        <p class="mt-4 text-base leading-relaxed text-slate">
          MarvikMantra Education Private Limited is a growing education institution in India, offering preparation for Medical and Engineering entrance exams, Olympiads and Board exams.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate">
          Through high-quality study material, regular assessments and technology-enabled learning systems, MarvikMantra delivers a results-oriented learning experience.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-3 text-sm text-ink">
            <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold"></span>
            Concept-based teaching with regular practice tests
          </li>
          <li class="flex items-start gap-3 text-sm text-ink">
            <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold"></span>
            Limited batch size for personalized attention
          </li>
        </ul>
      </div>
      <div class="grid grid-cols-3 gap-4 border border-ink/15 bg-paper p-8">
        {
          founders.map((f) => (
            <div class="text-center">
              <p class="font-mono text-xs text-gold">{f.years}</p>
              <p class="mt-2 font-display text-sm font-bold leading-tight text-ink">{f.name}</p>
              <p class="mt-1 text-xs text-slate">{f.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-ink/10 bg-paper">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[auto_1fr] md:items-start">
      <div class="border border-gold/40 p-6 md:w-64">
        <p class="font-mono text-xs uppercase tracking-wider text-crimson">{foundingDirector.years}</p>
        <p class="mt-2 font-display text-lg font-bold text-ink">{foundingDirector.title}</p>
        <p class="mt-1 text-sm font-medium text-gold">{foundingDirector.name}</p>
        <ul class="mt-4 space-y-2 text-xs text-slate">
          {foundingDirector.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <p class="text-base leading-relaxed text-slate">{foundingDirector.bio}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-6 py-16 md:grid-cols-2">
    <div class="border border-ink/15 bg-paper p-8">
      <p class="font-mono text-xs uppercase tracking-wider text-crimson">Our Mission</p>
      <p class="mt-3 text-base leading-relaxed text-ink">{mission}</p>
    </div>
    <div class="border border-ink/15 bg-paper p-8">
      <p class="font-mono text-xs uppercase tracking-wider text-crimson">Our Vision</p>
      <p class="mt-3 text-base leading-relaxed text-ink">{vision}</p>
    </div>
  </section>

  <WhyChoose />

  <CTASection />
</Layout>
