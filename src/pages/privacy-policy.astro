---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<Layout title="Privacy Policy">
  <PageHero eyebrow="Legal" title="Privacy Policy" />
  <section class="mx-auto max-w-3xl px-6 py-16 text-sm leading-relaxed text-slate">
    <!--
      TODO (dev note): this is a placeholder. Replace with real policy text
      reviewed by a lawyer before launch — this page collects contact-form
      data from minors' parents, so it should cover what's collected, how
      it's used/stored, and how a parent can request deletion.
    -->
    <p>
      {site.legalName} is committed to protecting the privacy of visitors to this website and of students and
      parents who share information with us. This page will be updated with our full privacy policy shortly.
    </p>
    <p class="mt-4">
      For any questions about your data, please <a href="/contact" class="text-gold hover:underline">contact us</a>.
    </p>
  </section>
</Layout>
