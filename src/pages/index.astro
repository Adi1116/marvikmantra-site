---
import Layout from "../layouts/Layout.astro";
import WhyChoose from "../components/WhyChoose.astro";
import CTASection from "../components/CTASection.astro";
import CourseCard from "../components/CourseCard.astro";
import { site, stats } from "../data/site";
import { courses } from "../data/courses";

const popularCourses = [...courses].sort((a, b) => a.level - b.level);
---

<Layout title="Home" description={site.description}>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid-pattern"></div>

    <div class="hero-shell">

      <div class="hero-content">
        <p class="eyebrow">
          Jaipur · Foundation · IIT-JEE · NEET
        </p>

        <h1>
          Build strong concepts.
          <span>Build a stronger future.</span>
        </h1>

        <p class="hero-description">
          MarvikMantra brings together experienced educators to help students
          build conceptual clarity, academic confidence and the foundations
          for competitive success.
        </p>

        <div class="hero-actions">
          <a href="#programs" class="button button-primary">
            Explore programs
            <span>→</span>
          </a>

          <a href="/contact" class="button button-secondary">
            Talk to an academic counsellor
          </a>
        </div>

        <div class="hero-note">
          <span class="hero-dot"></span>
          Admissions open for the current academic session
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-orbit hero-orbit-one"></div>
        <div class="hero-orbit hero-orbit-two"></div>

        <div class="hero-card">
          <div class="hero-card-top">
            <span>MARVIKMANTRA</span>
            <span>EST. 2026</span>
          </div>

          <div class="hero-logo-wrap">
            <img
              src="/logo.png"
              alt="MarvikMantra logo"
              class="hero-logo"
            />
          </div>

          <div class="hero-card-bottom">
            <span>Learn</span>
            <span>Understand</span>
            <span>Grow</span>
          </div>
        </div>

        <div class="floating-badge badge-one">
          <strong>18+</strong>
          <span>years of collective<br />teaching experience</span>
        </div>

        <div class="floating-badge badge-two">
          <strong>5000+</strong>
          <span>students<br />taught</span>
        </div>
      </div>

    </div>
  </section>


  <!-- TRUST STRIP -->
  <section class="stats-strip" id="results">
    <div class="stats-shell">
      {
        stats.map((stat, index) => (
          <div class="stat-item">
            <span class="stat-value">{stat.value}</span>
            <div>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-description">{stat.description}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>


  <!-- PHILOSOPHY -->
  <section class="philosophy">
    <div class="section-shell philosophy-grid">

      <div>
        <p class="eyebrow">Why MarvikMantra</p>

        <h2>
          Learning should change
          <span>how students think.</span>
        </h2>
      </div>

      <div class="philosophy-copy">
        <p>
          A strong academic foundation is more than remembering formulas.
          It is the ability to understand a problem, approach it with
          confidence and learn from every mistake.
        </p>

        <a href="/about" class="text-link">
          Discover our approach <span>→</span>
        </a>
      </div>

    </div>
  </section>


  <!-- JOURNEY -->
  <section class="journey">
    <div class="section-shell">

      <div class="section-heading centered">
        <p class="eyebrow">The MarvikMantra journey</p>

        <h2>
          From strong foundations
          <span>to ambitious goals.</span>
        </h2>

        <p>
          Every stage has a purpose. We help students grow from curious
          learners into confident aspirants.
        </p>
      </div>

      <div class="journey-line">

        <article class="journey-card">
          <span class="journey-number">01</span>
          <p class="journey-class">Classes 6–8</p>
          <h3>Build the foundation.</h3>
          <p>
            Develop curiosity, conceptual clarity and strong academic habits.
          </p>
        </article>

        <div class="journey-arrow">→</div>

        <article class="journey-card">
          <span class="journey-number">02</span>
          <p class="journey-class">Classes 9–10</p>
          <h3>Strengthen the way you solve.</h3>
          <p>
            Connect school learning with deeper problem-solving and competitive
            thinking.
          </p>
        </article>

        <div class="journey-arrow">→</div>

        <article class="journey-card">
          <span class="journey-number">03</span>
          <p class="journey-class">Class 11</p>
          <h3>Prepare with purpose.</h3>
          <p>
            Focused preparation for the JEE and NEET pathways.
          </p>
        </article>

      </div>
    </div>
  </section>


  <!-- PROGRAMS -->
  <section id="programs" class="programs">
    <div class="section-shell">

      <div class="section-heading">
        <div>
          <p class="eyebrow">Programs</p>

          <h2>
            Find the right path
            <span>for your child.</span>
          </h2>
        </div>

        <a href="/courses" class="text-link desktop-link">
          View all programs <span>→</span>
        </a>
      </div>

      <div class="programs-grid">
        {
          popularCourses.map((course) => (
            <CourseCard course={course} />
          ))
        }
      </div>

    </div>
  </section>


  <!-- APPROACH -->
  <WhyChoose />


  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="section-shell">
      <div class="final-cta-inner">

        <div>
          <p class="eyebrow light">Your next step</p>

          <h2>
            Let's find the right
            <span>path forward.</span>
          </h2>

          <p>
            Talk to our team about your child's academic goals, current class
            and the program that fits best.
          </p>
        </div>

        <a href="/contact" class="button button-light">
          Talk to an academic counsellor
          <span>→</span>
        </a>

      </div>
    </div>
  </section>

</Layout>