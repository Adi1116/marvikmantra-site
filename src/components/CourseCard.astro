---
import type { Course } from "../data/courses";
interface Props {
  course: Course;
}
const { course } = Astro.props;
---

<a
  href={`/courses/${course.slug}`}
  class="group flex flex-col border border-ink/15 bg-paper p-7 transition-colors hover:border-gold"
>
  <span class="font-mono text-xs uppercase tracking-wider text-crimson">{`Level ${course.level.toString().padStart(2, "0")}`}</span>
  <h3 class="mt-3 font-display text-xl font-bold text-ink">{course.name}</h3>
  <p class="mt-1 text-sm font-medium text-slate">{course.cardSummary}</p>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate">{course.focus}</p>

  <div class="mt-6 flex items-center justify-between border-t border-ink/10 pt-4 font-mono text-xs text-slate">
    <span>Duration: {course.duration}</span>
    <span>{course.studentCount} Students</span>
  </div>

  <span class="mt-4 inline-flex items-center gap-1 font-display text-sm font-semibold text-gold group-hover:text-crimson">
    Learn More →
  </span>
</a>
