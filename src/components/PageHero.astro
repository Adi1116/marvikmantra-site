---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<section class="border-b border-ink/10 bg-parchment">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-crimson">{eyebrow}</p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">
      {title}
    </h1>
    {subtitle && <p class="mt-4 max-w-xl text-base leading-relaxed text-slate">{subtitle}</p>}
  </div>
</section>
