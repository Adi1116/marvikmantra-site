---
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Ready to Start Your Success Journey?",
  body = "Join thousands of students who have achieved their dreams with our expert guidance and proven methods.",
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-16">
  <div class="flex flex-col items-start justify-between gap-6 border border-ink/15 bg-paper p-10 md:flex-row md:items-center">
    <div>
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink md:text-3xl">{heading}</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate">{body}</p>
    </div>
    <a
      href="/contact"
      class="whitespace-nowrap rounded-sm bg-crimson px-7 py-3.5 font-display text-sm font-semibold text-parchment transition-colors hover:bg-ink"
    >
      Schedule a Free Consultation
    </a>
  </div>
</section>
