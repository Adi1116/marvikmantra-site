---
import { whyChoose } from "../data/site";
---

<section id="approach" class="approach-section">
  <div class="section-shell">
    <div class="approach-intro">
      <div>
        <p class="eyebrow light">The MarvikMantra approach</p>

        <h2>
          We don't just prepare students
          <span>for an exam.</span>
        </h2>
      </div>

      <p class="approach-lead">
        We help students build the understanding, discipline and confidence
        needed to keep growing long after a single test is over.
      </p>
    </div>

    <div class="approach-grid">
      {
        whyChoose.map((item) => (
          <article class="approach-card">
            <span class="approach-number">{item.number}</span>

            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="approach-statement">
      <span>Understand</span>
      <i>→</i>
      <span>Apply</span>
      <i>→</i>
      <span>Assess</span>
      <i>→</i>
      <span>Improve</span>
      <i>→</i>
      <strong>Progress</strong>
    </div>
  </div>
</section>