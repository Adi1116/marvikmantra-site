---
// Signature element: a "result card" styled after an exam mark-sheet —
// stat rows with dotted leaders, since this content is genuinely about
// results and the audience reads mark-sheets every day.
import { stats, whyChoose } from "../data/site";
---

<section class="border-y border-ink/10 bg-ink text-parchment">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-bright">Result Card</p>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
      We don't just teach — we transform lives through education
    </h2>

    <div class="mt-10 grid gap-x-16 gap-y-4 border border-parchment/15 bg-ink-soft/40 p-8 md:grid-cols-2">
      {
        stats.map((s) => (
          <div class="flex items-baseline py-2">
            <span class="text-sm text-parchment/70">{s.label}</span>
            <span class="leader-dots !border-parchment/25" />
            <span class="font-mono text-xl font-semibold text-gold-bright">{s.value}</span>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        whyChoose.map((item) => (
          <div class="border-t border-gold-bright/40 pt-4">
            <h3 class="font-display text-base font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-parchment/70">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
