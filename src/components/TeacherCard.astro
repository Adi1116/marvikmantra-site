---
import type { Teacher } from "../data/teachers";
interface Props {
  teacher: Teacher;
}
const { teacher } = Astro.props;
---

<article class="flex flex-col border border-ink/15 bg-paper p-7">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-display text-lg font-bold text-ink">{teacher.name}</h3>
      <p class="mt-1 text-sm font-medium text-crimson">{teacher.subject}</p>
    </div>
    <span class="whitespace-nowrap font-mono text-xs uppercase tracking-wider text-slate">{teacher.experience}</span>
  </div>

  <p class="mt-3 text-xs text-slate">{teacher.qualification}</p>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate">{teacher.philosophy}</p>

  <p class="mt-4 text-xs leading-relaxed text-slate/80">
    <span class="font-semibold text-ink">Previous Associations:</span> {teacher.previousAssociations}
  </p>

  <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-1 border-t border-ink/10 pt-4">
    {
      teacher.achievements.map((a) => (
        <li class="rounded-sm bg-gold/10 px-2 py-1 font-mono text-[11px] uppercase tracking-wide text-gold">
          {a}
        </li>
      ))
    }
  </ul>
</article>
